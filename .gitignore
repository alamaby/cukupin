# Gradle
.gradle/
build/

# Catatan penting: gradle/wrapper/gradle-wrapper.jar DAN gradle-wrapper.properties
# SENGAJA di-commit. Wrapper butuh keduanya: `.jar` untuk menjalankan Gradle,
# `.properties` untuk memberi tahu Gradle versi apa yang harus diunduh. Mengabaikan
# keduanya membuat `./gradlew` mati bagi siapa pun yang clone repo ini.

